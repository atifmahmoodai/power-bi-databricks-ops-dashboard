-- Data quality page measures

DQ Flag Count =
COUNTROWS ( fact_data_quality_flags )

DQ Missing Records =
CALCULATE (
    COUNTROWS ( fact_data_quality_flags ),
    fact_data_quality_flags[FlagType] = "MissingRecord"
)

DQ Late Arriving Flags =
CALCULATE (
    COUNTROWS ( fact_data_quality_flags ),
    fact_data_quality_flags[FlagType] = "LateArriving"
)

DQ Anomaly Flags =
CALCULATE (
    COUNTROWS ( fact_data_quality_flags ),
    fact_data_quality_flags[FlagType] = "AnomalyVolume"
)

-- Expected shifts in period (illustrative): plants×lines×shifts×days
-- For demo, MissingRecord flags are pre-generated when a shift row was omitted.

DQ Health Score =
-- 1 = clean; lower when flags are dense vs production rows
VAR flags = [DQ Flag Count]
VAR prod = [Production Rows]
RETURN
    1 - DIVIDE ( flags, prod + flags )
