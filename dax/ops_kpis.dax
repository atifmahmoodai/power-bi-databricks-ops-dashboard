-- Operations KPIs

Units Good =
SUM ( fact_production[UnitsGood] )

Units Scrap =
SUM ( fact_production[UnitsScrap] )

Scrap % =
DIVIDE ( [Units Scrap], [Units Good] + [Units Scrap] )

Downtime Minutes =
SUM ( fact_production[DowntimeMinutes] )

Avg OEE =
AVERAGE ( fact_production[OEE] )

Production Rows =
COUNTROWS ( fact_production )

Late Arriving Rows =
CALCULATE (
    COUNTROWS ( fact_production ),
    fact_production[IsLateArriving] = 1
)

Late Arriving % =
DIVIDE ( [Late Arriving Rows], [Production Rows] )

Anomaly Rows =
CALCULATE (
    COUNTROWS ( fact_production ),
    fact_production[IsAnomaly] = 1
)

-- Time intelligence (add dim_date related to ProductionDate for production use)
Units Good Prior Day =
CALCULATE (
    [Units Good],
    DATEADD ( fact_production[ProductionDate], -1, DAY )
)

Units Good DoD Var =
[Units Good] - [Units Good Prior Day]
